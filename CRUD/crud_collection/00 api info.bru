tests {
  test("api info returns commands", async function () {
    const responseJson = res.getBody ? res.getBody() : await res.json();
    expect(responseJson.name).to.equal("CRUD Music API");
    expect(Array.isArray(responseJson.commands)).to.equal(true);
  });
}
